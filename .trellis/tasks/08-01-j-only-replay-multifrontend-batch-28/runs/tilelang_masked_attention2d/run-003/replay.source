import tilelang.language as T


@T.prim_func
def scrc_k0(
    p0: T.Tensor((16, 16), "float32"),
    p1: T.Tensor((16, 16), "float32"),
    p2: T.Tensor((16, 16), "float32"),
    p3: T.Tensor((1,), "float32"),
    p4: T.Tensor((16, 16), "float32"),
):
    with T.Kernel(16) as q:
        products = T.alloc_fragment((16, 16), "float32")
        dots = T.alloc_fragment((16,), "float32")
        scores = T.alloc_fragment((16,), "float32")
        row_max = T.alloc_fragment((1,), "float32")
        weights = T.alloc_fragment((16,), "float32")
        row_sum = T.alloc_fragment((1,), "float32")
        probabilities = T.alloc_fragment((16,), "float32")
        output_products = T.alloc_fragment((16,), "float32")
        output_value = T.alloc_fragment((1,), "float32")

        scale = T.float32(p3[0])

        for k, r in T.grid(16, 16):
            products[k, r] = p0[q, r] * p1[k, r]
        T.reduce_sum(products, dots, dim=1, clear=True)

        for k in T.serial(16):
            unmasked = T.float32(dots[k] * scale)
            masked = T.float32(-1000000000.0)
            scores[k] = T.if_then_else(q >= k, unmasked, masked)

        T.reduce_max(scores, row_max, dim=0, clear=True)

        for k in T.serial(16):
            weights[k] = T.exp(scores[k] - row_max[0])
        T.reduce_sum(weights, row_sum, dim=0, clear=True)

        for k in T.serial(16):
            probabilities[k] = weights[k] / row_sum[0]

        for d in T.serial(16):
            for k in T.serial(16):
                output_products[k] = probabilities[k] * p2[k, d]
            T.reduce_sum(output_products, output_value, dim=0, clear=True)
            p4[q, d] = output_value[0]
