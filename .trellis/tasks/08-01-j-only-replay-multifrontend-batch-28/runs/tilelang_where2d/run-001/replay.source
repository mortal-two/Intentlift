import tilelang.language as T


@T.prim_func
def scrc_k0(
    p0: T.Tensor((T.dynamic("x0"), 16), "float32"),
    p1: T.Tensor((T.dynamic("x0"), 16), "float32"),
    p2: T.Tensor((T.dynamic("x0"), 16), "float32"),
):
    with T.Kernel(p0.shape[0], threads=c0) as v2:
        for v3 in T.serial(16):
            p2[v2, v3] = T.if_then_else(
                p0[v2, v3] > p1[v2, v3], p0[v2, v3], p1[v2, v3]
            )
