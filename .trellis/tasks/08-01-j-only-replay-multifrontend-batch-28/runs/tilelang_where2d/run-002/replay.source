import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 16), "float32"),
    p1: T.Tensor((X0, 16), "float32"),
    p2: T.Tensor((X0, 16), "float32"),
):
    with T.Kernel(X0, threads=c0) as v2:
        for v3 in T.Parallel(16):
            p0_value = p0[v2, v3]
            p1_value = p1[v2, v3]
            p2[v2, v3] = T.if_then_else(
                p0_value > p1_value, p0_value, p1_value
            )
