import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 64), "float32"),
    p1: T.Tensor((X0,), "bool"),
    p2: T.Tensor((X0, 64), "float32"),
):
    with T.Kernel(X0, threads=c0) as v2:
        for v3 in T.serial(64):
            p2[v2, v3] = p0[v2, v3] * T.Cast("float32", p1[v2])
