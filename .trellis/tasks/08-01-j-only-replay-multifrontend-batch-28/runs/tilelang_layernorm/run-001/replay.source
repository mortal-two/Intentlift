import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 16), "float32"),
    p1: T.Tensor((X0, 16), "float32"),
    p2: T.Tensor((16,), "float32"),
    p3: T.Tensor((16,), "float32"),
    p4: T.Tensor((X0,), "float32"),
    p5: T.Tensor((X0,), "float32"),
):
    with T.Kernel(X0, threads=c0) as v13:
        row = T.alloc_fragment((16,), "float32")
        mean = T.alloc_fragment((1,), "float32")
        squares = T.alloc_fragment((16,), "float32")
        rstd = T.alloc_fragment((1,), "float32")

        T.copy(p0[v13, 0], row)
        T.reduce_sum(row, mean, dim=0)
        mean[0] = mean[0] * T.float32(0.0625)
        p4[v13] = mean[0]

        for v14 in T.Parallel(16):
            centered = row[v14] - mean[0]
            squares[v14] = centered * centered

        T.reduce_sum(squares, rstd, dim=0)
        rstd[0] = T.rsqrt(
            rstd[0] * T.float32(0.0625) + T.float32(1e-05)
        )
        p5[v13] = rstd[0]

        for v14 in T.Parallel(16):
            p1[v13, v14] = (
                (row[v14] - mean[0]) * rstd[0] * p2[v14] + p3[v14]
            )
