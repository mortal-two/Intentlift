extern "C" __global__ void scrc_k0(const float* p0,
                                    const float* p1,
                                    float* p2,
                                    int p3) {
    const int v1 = static_cast<int>(blockIdx.x);
    const int v2 = static_cast<int>(threadIdx.x);
    const int offset = v1 * 16 + v2;
    p2[offset] = p1[offset] + p0[v2];
}
