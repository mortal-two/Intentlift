import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 64, 16), "float32"),
    p1: T.Tensor((X0, 64, 16), "float32"),
    p2: T.Tensor((64,), "float32"),
    p3: T.Tensor((64,), "float32"),
    p4: T.Tensor((X0, 4), "float32"),
    p5: T.Tensor((X0, 4), "float32"),
):
    with T.Kernel(X0, threads=c0) as v23:
        x_local = T.alloc_fragment((4, 256), "float32")
        square_local = T.alloc_fragment((4, 256), "float32")
        sum_local = T.alloc_fragment((4,), "float32")
        square_sum_local = T.alloc_fragment((4,), "float32")
        mean_local = T.alloc_fragment((4,), "float32")
        inv_std_local = T.alloc_fragment((4,), "float32")

        T.copy(p0[v23, 0, 0], x_local)

        for v26, v27 in T.Parallel(4, 256):
            square_local[v26, v27] = x_local[v26, v27] * x_local[v26, v27]

        T.reduce_sum(x_local, sum_local, dim=1)
        T.reduce_sum(square_local, square_sum_local, dim=1)

        for v26 in T.serial(4):
            mean_local[v26] = sum_local[v26] * T.float32(0.00390625)
            inv_std_local[v26] = T.rsqrt(
                square_sum_local[v26] * T.float32(0.00390625)
                - mean_local[v26] * mean_local[v26]
                + T.float32(1e-05)
            )
            p4[v23, v26] = mean_local[v26]
            p5[v23, v26] = inv_std_local[v26]

        for v24 in T.serial(64):
            v21_scale = T.float32(p2[v24])
            v22_bias = T.float32(p3[v24])
            for v25 in T.serial(16):
                p1[v23, v24, v25] = (
                    (x_local[v24 // 16, (v24 % 16) * 16 + v25] - mean_local[v24 // 16])
                    * inv_std_local[v24 // 16]
                    * v21_scale
                    + v22_bias
                )
