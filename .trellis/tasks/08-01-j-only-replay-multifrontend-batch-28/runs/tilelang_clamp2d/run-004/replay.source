import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 16), "float32"),
    p1: T.Tensor((1,), "float32"),
    p2: T.Tensor((1,), "float32"),
    p3: T.Tensor((X0, 16), "float32"),
):
    with T.Kernel(X0, threads=c0) as v2:
        p1_scalar = T.float32(p1[0])
        p2_scalar = T.float32(p2[0])
        for v3 in T.Parallel(16):
            max_value = T.float32(T.max(p0[v2, v3], p1_scalar))
            min_value = T.float32(T.min(max_value, p2_scalar))
            p3[v2, v3] = min_value
