import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 16), "float32"),
    p1: T.Tensor((X0, 16), "float32"),
    p2: T.Tensor((X0,), "float32"),
    p3: T.Tensor((X0,), "float32"),
):
    with T.Kernel(X0, threads=c0) as v5:
        row = T.alloc_fragment((16,), "float32")
        row_max = T.alloc_fragment((1,), "float32")
        row_exp = T.alloc_fragment((16,), "float32")
        row_sum = T.alloc_fragment((1,), "float32")

        T.copy(p0[v5, 0], row)
        T.reduce_max(row, row_max, dim=0, clear=True)
        max_value = T.float32(row_max[0])
        T.copy(row_max, p2[v5])

        for v6 in T.Parallel(16):
            row_exp[v6] = T.exp(row[v6] - max_value)

        T.reduce_sum(row_exp, row_sum, dim=0, clear=True)
        sum_value = T.float32(row_sum[0])
        T.copy(row_sum, p3[v5])

        for v6 in T.Parallel(16):
            row_exp[v6] = row_exp[v6] / sum_value

        T.copy(row_exp, p1[v5, 0])
