import tilelang.language as T

X0 = T.dynamic("x0")
X1_1 = T.dynamic("x1_1")
X2_1 = T.dynamic("x2_1")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, X1_1), "float16"),
    p1: T.Tensor((X1_1, X2_1), "float16"),
    p2: T.Tensor((X0, X2_1), "float16"),
):
    with T.Kernel(X0, X2_1, threads=c0) as (v6, v7):
        lhs = T.alloc_fragment((1,), "float16")
        rhs = T.alloc_fragment((1,), "float16")
        products = T.alloc_fragment((1,), "float32")
        reduced = T.alloc_fragment((1,), "float32")

        zero = T.float32(0.0)
        reduced[0] = T.float32(0.0)
        for v8 in T.serial(X1_1):
            T.copy(p0[v6, v8 : v8 + 1], lhs)
            T.copy(p1[v8 : v8 + 1, v7], rhs)
            products[0] = T.float32(lhs[0]) * T.float32(rhs[0])
            T.reduce(products, reduced, "sum", dim=0, clear=False)
        activated = T.float32(T.max(reduced[0], zero))
        p2[v6, v7] = T.float16(activated)
