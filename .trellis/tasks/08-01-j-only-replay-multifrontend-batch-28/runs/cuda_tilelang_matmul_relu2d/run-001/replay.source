extern "C" __global__ void scrc_k0(const float* p0,
                                     const float* p1,
                                     float* p2,
                                     int p3,
                                     int p4,
                                     int p5) {
  __shared__ float reduction_values[1024];

  const int v3 = static_cast<int>(blockIdx.x);
  const unsigned int lane = threadIdx.x;

  for (int v4 = 0; v4 < p5; ++v4) {
    float contribution = 0.0f;
    if (lane < static_cast<unsigned int>(p3)) {
      const int v5 = static_cast<int>(lane);
      contribution +=
          p0[static_cast<long long>(v3) * p3 + v5] *
          p1[static_cast<long long>(v5) * p5 + v4];
    }

    reduction_values[lane] = contribution;
    __syncthreads();

    unsigned int active = blockDim.x;
    while (active > 1u) {
      const unsigned int upper = (active + 1u) >> 1;
      if (lane < active - upper) {
        reduction_values[lane] += reduction_values[lane + upper];
      }
      __syncthreads();
      active = upper;
    }

    if (lane == 0u) {
      p2[static_cast<long long>(v3) * p5 + v4] =
          fmaxf(reduction_values[0], 0.0f);
    }
    __syncthreads();
  }
}
