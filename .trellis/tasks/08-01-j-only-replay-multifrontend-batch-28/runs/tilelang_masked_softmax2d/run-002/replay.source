import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 64), "float32"),
    p1: T.Tensor((64,), "bool"),
    p2: T.Tensor((X0, 64), "float32"),
):
    with T.Kernel(X0, threads=c0) as v12:
        scores = T.alloc_fragment((64,), "float32")
        row_max = T.alloc_fragment((1,), "float32")
        row_sum = T.alloc_fragment((1,), "float32")

        one = T.float32(1.0)
        negative_large = T.float32(-1000000000.0)

        for v13 in T.Parallel(64):
            mask_value = T.if_then_else(p1[v13], T.float32(1.0), T.float32(0.0))
            inverse_mask = one - mask_value
            masked_input = p0[v12, v13] * mask_value
            masked_bias = negative_large * inverse_mask
            scores[v13] = masked_input + masked_bias

        T.reduce_max(scores, row_max, dim=0, clear=True)

        for v13 in T.Parallel(64):
            scores[v13] = T.exp(scores[v13] - row_max[0])

        T.reduce_sum(scores, row_sum, dim=0, clear=True)

        for v13 in T.Parallel(64):
            p2[v12, v13] = scores[v13] / row_sum[0]
