extern "C" __global__ void scrc_k0(const float* p0,
                                     const signed char* p1,
                                     float* p2,
                                     int p3) {
  const int v13 = static_cast<int>(blockIdx.x);
  const int v14 = static_cast<int>(threadIdx.x);
  const int offset = v13 * 64 + v14;

  const bool v0 = static_cast<bool>(p1[v14]);
  const float v1 = static_cast<float>(v0);
  const float v3 = 1.0f - v1;
  const float v4 = p0[offset] * v1;
  const float v6 = -1000000000.0f * v3;
  const float v7 = v4 + v6;

  __shared__ float reduction[64];

  float v8 = fmaxf(-__int_as_float(0x7f800000), v7);
  reduction[v14] = v8;
  __syncthreads();
  for (int stride = 32; stride != 0; stride >>= 1) {
    if (v14 < stride) {
      reduction[v14] = fmaxf(reduction[v14], reduction[v14 + stride]);
    }
    __syncthreads();
  }
  v8 = reduction[0];

  const float v9 = v7 - v8;
  const float v10 = expf(v9);

  float v11 = 0.0f + v10;
  reduction[v14] = v11;
  __syncthreads();
  for (int stride = 32; stride != 0; stride >>= 1) {
    if (v14 < stride) {
      reduction[v14] = reduction[v14] + reduction[v14 + stride];
    }
    __syncthreads();
  }
  v11 = reduction[0];

  p2[offset] = v10 / v11;
}
