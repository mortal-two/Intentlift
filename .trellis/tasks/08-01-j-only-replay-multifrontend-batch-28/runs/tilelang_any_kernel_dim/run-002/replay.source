import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 16), "float32"),
    p1: T.Tensor((X0,), "bool"),
):
    with T.Kernel(X0, threads=c0) as v3:
        row = T.alloc_fragment((16,), "float32")
        row_max = T.alloc_fragment((1,), "float32")
        T.copy(p0[v3, 0:16], row)
        T.reduce_max(row, row_max, dim=0)
        p1[v3] = row_max[0] != T.float32(0.0)
