import tilelang.language as T

X0 = T.dynamic("x0")


@T.prim_func
def scrc_k0(
    p0: T.Tensor((X0, 16), "float32"),
    p1: T.Tensor((X0,), "float32"),
):
    with T.Kernel(X0, threads=c0) as v1:
        row = T.alloc_fragment((16,), "float32")
        result = T.alloc_fragment((1,), "float32")
        T.copy(p0[v1, :], row)
        T.fill(result, -T.infinity("float32"))
        T.reduce_max(row, result, dim=0, clear=False)
        p1[v1] = result[0]
