    "g6_fusion_composition": 6,
    "g7_cross_feature_stress": 7
  },
  "primary_unique_pair_count": 20,
  "primary_frontend_artifact_count": 40,
  "robustness_unique_pair_count": 31,
  "robustness_frontend_artifact_count": 62
}
