extern "C" __global__ void scrc_k0(const float* p0,
                                     const float* p1,
                                     float* p2,
                                     int p3) {
  const int v1 = static_cast<int>(blockIdx.x);
  if (v1 < p3) {
    for (int v2 = static_cast<int>(threadIdx.x); v2 < 16;
         v2 += static_cast<int>(blockDim.x)) {
      const unsigned long long offset =
          static_cast<unsigned long long>(v1) * 16ull +
          static_cast<unsigned long long>(v2);
      p2[offset] = p0[offset] + p1[offset];
    }
  }
}
