{
  "intent_function": {
    "name": "flash_attention_fwd",
    "inputs": [
      {"name": "Q", "dtype": "f16", "shape": ["B", "H", "Sq", "D"]},
      {"name": "K", "dtype": "f16", "shape": ["B", "H", "Sk", "D"]},
      {"name": "V", "dtype": "f16", "shape": ["B", "H", "Sk", "D"]},
      {"name": "scale", "dtype": "f32", "shape": []}
    ],
    "outputs": [
      {"name": "O", "dtype": "f16", "shape": ["B", "H", "Sq", "D"]}
    ],
    "layer_c": {"tile": {"Sk": "BK", "Sq": "BQ"}, "vector_width": 128},
    "body": [
      {
        "op": "loop",
        "result": ["m", "l", "Oacc"],
        "carry": [
          {"name": "m", "init": "NEG_INF"},
          {"name": "l", "init": "0"},
          {"name": "Oacc", "init": "zeros"}
        ],
        "trip": {"axis": "Sk", "tile_hint": "BK"},
        "scan": [
          {"name": "Kj", "from": "K", "axis": 2},
          {"name": "Vj", "from": "V", "axis": 2}
        ],
        "body": [
          {"op": "contraction", "result": "S0", "operands": ["Q", "Kj"],
           "attrs": {"subscripts": "bhqd,bhkd->bhqk"},
           "layer_b": {"bounds": ["k < Sk"]}},
          {"op": "map_binary", "result": "S", "operands": ["S0", "scale"],
           "attrs": {"fn": "mul", "broadcast": "scalar"}},
          {"op": "reduce", "result": "m_blk", "operands": ["S"],
           "attrs": {"fn": "max", "axes": [3], "assoc": "associative"}},
          {"op": "map_binary", "result": "m_new", "operands": ["m", "m_blk"],
           "attrs": {"fn": "max"}},
          {"op": "map_binary", "result": "Sc", "operands": ["S", "m_new"],
           "attrs": {"fn": "sub", "broadcast": "row"}},
          {"op": "map_unary", "result": "P", "operands": ["Sc"],
           "attrs": {"fn": "exp"}},
          {"op": "map_binary", "result": "corr", "operands": ["m", "m_new"],
           "attrs": {"fn": "sub"}},
          {"op": "map_unary", "result": "alpha", "operands": ["corr"],
           "attrs": {"fn": "exp"}},
          {"op": "reduce", "result": "p_sum", "operands": ["P"],
           "attrs": {"fn": "sum", "axes": [3], "assoc": "float_nondeterministic"}},
          {"op": "map_binary", "result": "l_scaled", "operands": ["l", "alpha"],
           "attrs": {"fn": "mul"}},
          {"op": "map_binary", "result": "l_new", "operands": ["l_scaled", "p_sum"],
           "attrs": {"fn": "add"}},
          {"op": "contraction", "result": "PV", "operands": ["P", "Vj"],
           "attrs": {"subscripts": "bhqk,bhkd->bhqd"}},
          {"op": "map_binary", "result": "O_scaled", "operands": ["Oacc", "alpha"],
           "attrs": {"fn": "mul", "broadcast": "row"}},
          {"op": "map_binary", "result": "O_new", "operands": ["O_scaled", "PV"],
           "attrs": {"fn": "add"}}
        ],
        "yield": ["m_new", "l_new", "O_new"]
      },
      {"op": "map_binary", "result": "O", "operands": ["Oacc", "l"],
       "attrs": {"fn": "div", "broadcast": "row"}, "out": "O"}
    ]
  }
}
