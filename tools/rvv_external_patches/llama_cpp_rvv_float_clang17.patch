diff --git a/ggml/src/ggml-cpu/CMakeLists.txt b/ggml/src/ggml-cpu/CMakeLists.txt
index 836bae4..8a1a17b 100644
--- a/ggml/src/ggml-cpu/CMakeLists.txt
+++ b/ggml/src/ggml-cpu/CMakeLists.txt
@@ -437,10 +437,17 @@ function(ggml_add_cpu_backend_variant_impl tag_name)
         endif()
     elseif (GGML_SYSTEM_ARCH STREQUAL "riscv64")
         message(STATUS "riscv64 detected")
-        list(APPEND GGML_CPU_SOURCES
-            ggml-cpu/arch/riscv/quants.c
-            ggml-cpu/arch/riscv/repack.cpp
-            )
+        if (NOT GGML_RVV_FLOAT_ONLY)
+            list(APPEND GGML_CPU_SOURCES
+                ggml-cpu/arch/riscv/quants.c
+                ggml-cpu/arch/riscv/repack.cpp
+                )
+        else()
+            # Keep the public ggml CPU library link-complete while excluding
+            # RVV quant sources that require newer intrinsic tuple APIs.  The
+            # floating-point kernels still compile with rv64gcv below.
+            list(APPEND ARCH_FLAGS -DGGML_CPU_GENERIC)
+        endif()
         if (GGML_CPU_RISCV64_SPACEMIT)
             include(ggml-cpu/cmake/FindSMTIME.cmake)
             target_compile_definitions(${GGML_CPU_NAME} PRIVATE GGML_USE_CPU_RISCV64_SPACEMIT ${RISCV64_SPACEMIT_IME_SPEC})
