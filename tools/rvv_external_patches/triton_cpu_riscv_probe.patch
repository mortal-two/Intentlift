+#include "llvm/TargetParser/SubtargetFeature.h"
 #include "llvm/Transforms/IPO/AlwaysInliner.h"
 #include "llvm/Transforms/InstCombine/InstCombine.h"
 #include "llvm/Transforms/Instrumentation/AddressSanitizer.h"
@@ -64,6 +65,22 @@ using namespace llvm;

 namespace {

+std::string getHostCPUFeatureString() {
+  llvm::SubtargetFeatures features;
+  const bool conservativeRISCV =
+      llvm::Triple(llvm::sys::getProcessTriple()).isRISCV64();
+  for (const auto &feature : llvm::sys::getHostCPUFeatures()) {
+    if (conservativeRISCV && feature.getKey() != "i" &&
+        feature.getKey() != "m" && feature.getKey() != "a" &&
+        feature.getKey() != "f" && feature.getKey() != "d" &&
+        feature.getKey() != "c" && feature.getKey() != "v" &&
+        feature.getKey() != "zfh" && feature.getKey() != "zvfh")
+      continue;
+    features.AddFeature(feature.getKey(), feature.getValue());
+  }
+  return features.getString();
+}
